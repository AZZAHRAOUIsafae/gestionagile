rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Avatars: Users can only upload their own avatar
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn(); // Avatars are public to other users
      allow write: if isEmailVerified() && request.auth.uid == userId && 
                     request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                     request.resource.contentType.matches('image/.*');
    }

    // Projects: Only project members or admins can access files
    match /documents/{projectId}/{fileName} {
      function hasProjectAccess() {
        // Since we can't easily reach Firestore from Storage rules without 'firestore' helper
        // which has some latency/cost, we'll assume the path includes project ID
        // In a real production app, we would use:
        // return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.clientId == request.auth.uid;
        // But for this project, files are currently Base64 in Firestore, so these rules are for future SDK usage.
        return isSignedIn(); 
      }

      allow read, write: if isEmailVerified() && hasProjectAccess();
    }
  }
}
